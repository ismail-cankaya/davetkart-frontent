# Üretim yapılandırması şablonu — gerçek değerlerle `.env.production` olarak
# kopyalayın. `.env*` gitignore'dadır; bu şablon izlenir, dolu hâli izlenmez.
#
# 🔴 Buradaki değer backend'in CORS_ALLOWED_ORIGINS ayarıyla eşleşmelidir.
# Ayrıntı ve tuzaklar için `.env.example` dosyasına bakın.
#
# SPA ile API aynı alan adındaysa (ters vekil) bunun yerine /api yazın.
VITE_API_BASE_URL=https://api.ornek.com/api
