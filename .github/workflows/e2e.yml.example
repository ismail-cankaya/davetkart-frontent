# TASLAK (Faz 19.22, TST-04, §A-1): GitHub yalnızca .yml/.yaml koşturur; bu dosya çalışmaz.
# Etkinleştirmek için: e2e.yml olarak kopyala, backend deposunun erişimini ve sırları ayarla.
# Ayrıntı: docs/rehber/playwright.config.md
name: e2e

on:
  workflow_dispatch:

jobs:
  e2e:
    runs-on: windows-latest   # scripts/e2e/backend.ps1 PowerShell; ubuntu için pwsh de yeter
    timeout-minutes: 20
    services: {}              # windows koşucusunda servis kapsayıcısı yok: PostgreSQL aşağıda kurulur
    env:
      E2E_BACKEND_PORT: 8020
      E2E_PREVIEW_PORT: 4180
    steps:
      - uses: actions/checkout@v4
        with:
          path: davetkart-frontent
      - uses: actions/checkout@v4
        with:
          repository: <org>/davetkart-backend-php-laravel   # doldur
          path: davetkart-backend-php-laravel
          token: ${{ secrets.BACKEND_REPO_TOKEN }}
      - name: PostgreSQL
        run: |
          choco install postgresql18 --params '/Password:postgres' -y
          echo "C:\Program Files\PostgreSQL\18\bin" >> $env:GITHUB_PATH
      - uses: shivammathur/setup-php@v2
        with:
          php-version: '8.5'
          extensions: pdo_pgsql, intl, gd
      - name: Backend
        working-directory: davetkart-backend-php-laravel
        run: |
          composer install --no-interaction --prefer-dist
          copy .env.example .env
          php artisan key:generate
          # .env: DB_USERNAME=postgres, DB_PASSWORD=postgres (backend.ps1 yalnızca bağlantıyı okur)
      - uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm
          cache-dependency-path: davetkart-frontent/package-lock.json
      - name: Frontend
        working-directory: davetkart-frontent
        run: |
          npm ci
          npx playwright install chromium
          npm run e2e
      - uses: actions/upload-artifact@v4
        if: failure()
        with:
          name: playwright-report
          path: davetkart-frontent/playwright-report
